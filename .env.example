# Sem chaves o app roda em modo offline (heurística local, não é o Jev).
TYPESAFE_API_KEY=

# Resumo dos momentos-chave e tradução dos benchmarks, no formato do init_chat_model.
# Padrão: OpenRouter, que dá acesso a vários modelos com uma chave só e, aqui, só usa
# provedores que não guardam os dados (CONVERSA_OPENROUTER_PRIVADO=0 desliga).
CONVERSA_CHAT_MODEL=openrouter:openai/gpt-5-nano
OPENROUTER_API_KEY=

# Só para áudio mono (gpt-4o-transcribe-diarize) ou para usar a OpenAI direto
# (CONVERSA_CHAT_MODEL=openai:gpt-5-nano).
OPENAI_API_KEY=

# Tamanho do Whisper local: tiny, base, small (padrão), medium, large-v3.
# CONVERSA_WHISPER_MODEL=small
# Modelo de satisfação calibrado (gerado por `csat treinar`).
# CONVERSA_CSAT_MODEL=csat_model.json
# Cache das respostas do Jev (0 desliga, ou um caminho .sqlite).
# CONVERSA_CACHE=
