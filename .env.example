# Sem chaves o app roda em modo offline (heurística local, não é o Jev).
TYPESAFE_API_KEY=
# Modelo do resumo, no formato do init_chat_model. Instale o pacote do provedor
# (langchain-anthropic, langchain-openai...) e defina a chave dele.
CONVERSA_CHAT_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
# Só para áudio mono (gpt-4o-transcribe-diarize) ou resumo com modelo da OpenAI.
OPENAI_API_KEY=
# Tamanho do Whisper local: tiny, base, small (padrão), medium, large-v3.
# CONVERSA_WHISPER_MODEL=small
# Modelo de satisfação calibrado (gerado por `csat treinar`).
# CONVERSA_CSAT_MODEL=csat_model.json
